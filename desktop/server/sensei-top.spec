# PyInstaller spec for the frozen server (docs/architecture.md, "The desktop
# shell", "The frozen server"). Run by scripts/build_server.py, which gives it
# the work and dist paths; run by hand it is
#   uv run pyinstaller desktop/server/sensei-top.spec
# This file is Python that PyInstaller execs: SPECPATH is its directory.
from pathlib import Path

from PyInstaller.utils.hooks import collect_data_files, collect_submodules, copy_metadata

root = Path(SPECPATH).resolve().parents[1]
work = Path(SPECPATH).resolve() / "build"
work.mkdir(parents=True, exist_ok=True)

# PyInstaller wants a script. The console_script entry point is generated by
# the installer, so the frozen build gets the same one-liner written here.
entry = work / "entry.py"
entry.write_text("from sensei_top.cli import main\n\nmain()\n", encoding="utf-8")

# api/app.py reads the version from importlib.metadata, which raises when the
# frozen build lacks sensei_top-*.dist-info (logs.py falls back to "unknown").
# keyring finds its backends through entry points, which are also dist-info.
datas = copy_metadata("sensei-top") + copy_metadata("keyring")
# migrations/ and web_dist/ (and any other non-Python file the package ships),
# found through importlib.resources at run time.
datas += collect_data_files("sensei_top")

hiddenimports = []
# uvicorn imports its loop, protocol and lifespan modules by name from a
# string, which the analysis cannot see.
hiddenimports += collect_submodules("uvicorn")
# keyring picks a backend by entry-point name, then imports it. Every
# platform's backend is listed; the unused ones are small.
hiddenimports += collect_submodules("keyring.backends")

a = Analysis(
    [str(entry)],
    pathex=[str(root / "src")],
    datas=datas,
    hiddenimports=hiddenimports,
)
# An editable install's dist-info carries direct_url.json, a file:// URL naming
# the builder's directory. Nothing reads it; it must not ship.
a.datas = [d for d in a.datas if Path(d[0]).name != "direct_url.json"]
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,  # --onedir: the binaries sit beside the executable
    name="sensei-top",
    console=True,  # the shell reads stdout, and a windowed exe has none
    upx=False,
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    name="sensei-top",
    upx=False,
)
