{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/ai", "**/ai/**", "!**/ai/registry"],
            "message": "Outside src/ai/, import only src/ai/registry (useAi), never another ai/ module."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/MatchReportPanel.tsx",
        "src/components/MatchupBriefCard.tsx",
        "src/components/MatchupCoverageCard.tsx",
        "src/components/PairingBrief.tsx",
        "src/components/SideboardPlanCard.tsx",
        "src/components/guide/LeakCard.tsx",
        "src/components/guide/WriteAndExport.tsx",
        "src/views/RcqView.tsx",
        "src/views/SurfacesView.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
