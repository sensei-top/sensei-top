.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
*.db
*.db-wal
*.db-shm
# Daily backup slots (src/sensei_top/backup/). *.db does not match these --
# today they are covered only because `data/` is ignored wholesale below, but
# the backup destination is configurable ($SENSEI_TOP_BACKUP_DIR / [backup] dir),
# so a slot can land outside data/ too.
*.db.backup
*.db.backup.[0-9]*
.env
data/
dist/
src/sensei_top/web_dist/
build/
# ...except the desktop shell's packaging resources (icon, NSIS include).
!desktop/build/
desktop/release/
# The desktop shell's dependencies (desktop/dist/ is covered by dist/ above).
desktop/node_modules/
.claude/handoffs/
# Per-user Claude Code settings; the shared skill under .claude/skills/ stays tracked.
.claude/settings.local.json
# Local agent definitions and the plan-running skill: they name plans and
# handoffs that live outside the tree. navigating-sensei-top stays tracked.
.claude/agents/
.claude/skills/running-a-plan/
# Personal deck prep (guides, sideboard plans, one-off scripts), kept on disk
# but out of the repo; the Deck guide tab is the product's version of it.
guides/

# wrangler dev's local state (docs/frontend-site.md, "The site")
.wrangler/

# the Playwright MCP's screenshots and snapshots (BL-088); it writes only inside the repo
.playwright-mcp/

# Impeccable's working files (BL-088); the block is its README's, verbatim
# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# The **/ prefix covers .impeccable at the repo root or in a nested workspace.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, surfaces/*.md, critique/*.md.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end
